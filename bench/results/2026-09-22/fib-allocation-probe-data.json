  "patches": {
    "checked-harness": "--- a/bench/bench.kt\n+++ b/bench/bench.kt\n@@ -180,6 +180,23 @@\n open class Fib : ComparedBenchmark() {\n   @Param(\"10\", \"15\") @JvmField var size: Int = 0\n   override val text = \"fixNatF (\\\\(f : Nat -> Nat) (x : Nat) -> if le x 1 then x else plus (f (minus x 1)) (f (minus x 2)))\"\n+\n+  override fun prepareBaseline() {\n+    super.prepareBaseline()\n+    repeat(4) { offset ->\n+      val input = size + offset\n+      var previous = 0\n+      var current = 1\n+      repeat(input) {\n+        val next = Math.addExact(previous, current)\n+        previous = current\n+        current = next\n+      }\n+      val actual = target.call(input)\n+      check(actual == previous) { \"Fib setup input=$input expected=$previous actual=$actual\" }\n+      println(\"FIB_SETUP_CHECK input=$input expected=$previous actual=$actual\")\n+    }\n+  }\n \n   // Keep the varying range small: each extra Fibonacci level nearly doubles the work.\n   @Benchmark fun cadenza(): Any? = target.call(size + (nextInput(0) and 3))\n",
    "padding2": "--- a/src/cadenza/data/Closure.kt\n+++ b/src/cadenza/data/Closure.kt\n@@ -130,7 +130,7 @@\n }\n \n fun appendLSkip(skip: Int, xs: Array<out Any?>?, xsSize: Int, ys: Array<out Any?>?, ysSize: Int): Array<Any?> {\n-  val zs = arrayOfNulls<Any>(skip + xsSize + ysSize)\n+  val zs = arrayOfNulls<Any>(skip + xsSize + ysSize + 2)\n   System.arraycopy(xs, 0, zs, skip, xsSize)\n   System.arraycopy(ys, 0, zs, skip + xsSize, ysSize)\n   return zs\n",
    "padding4": "--- a/src/cadenza/data/Closure.kt\n+++ b/src/cadenza/data/Closure.kt\n@@ -130,7 +130,7 @@\n }\n \n fun appendLSkip(skip: Int, xs: Array<out Any?>?, xsSize: Int, ys: Array<out Any?>?, ysSize: Int): Array<Any?> {\n-  val zs = arrayOfNulls<Any>(skip + xsSize + ysSize)\n+  val zs = arrayOfNulls<Any>(skip + xsSize + ysSize + 4)\n   System.arraycopy(xs, 0, zs, skip, xsSize)\n   System.arraycopy(ys, 0, zs, skip + xsSize, ysSize)\n   return zs\n"
  }
