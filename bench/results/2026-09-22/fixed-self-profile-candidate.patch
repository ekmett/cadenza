@@ -0,0 +1,137 @@
+import cadenza.Language
+import cadenza.data.Closure
+import cadenza.jit.*
+import com.oracle.truffle.api.RootCallTarget
+import com.oracle.truffle.api.frame.VirtualFrame
+import com.oracle.truffle.api.interop.InteropLibrary
+import com.oracle.truffle.api.nodes.DirectCallNode
+import com.oracle.truffle.api.nodes.NodeUtil
+import com.oracle.truffle.api.profiles.ValueProfile
+import com.oracle.truffle.api.source.Source
+import org.graalvm.polyglot.Context
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+
+class FixedArgumentProfileTests {
+  private fun withLanguage(action: (Language) -> Unit) {
+    Context.create("cadenza").use { context ->
+      context.initialize("cadenza")
+      context.enter()
+      try { action(Language.currentLanguage()) } finally { context.leave() }
+    }
+  }
+
+  private fun builtin(language: Language) = FixNatFNodeGen.create().also {
+    BuiltinRootNode(language, it).callTarget
+  }
+
+  private class ObservedBody(language: Language) {
+    val seen = mutableListOf<Closure>()
+    private val layout = FrameLayout()
+    private val selfSlot = layout.slot("self")
+    private val argumentSlot = layout.slot("n")
+    val root = ClosureRootNode(language, layout.build(), 2,
+      argPreamble = arrayOf(selfSlot to 0, argumentSlot to 1),
+      body = ClosureBody(object : Code(null) {
+        override fun execute(frame: VirtualFrame): Any {
+          val self = FrameAccess.read(frame, selfSlot) as Closure
+          seen += self
+          val n = FrameAccess.read(frame, argumentSlot) as Int
+          if (n == 0) return 0
+          // Exercise argument resolution on every self-tail frame rebuild as well
+          // as entry. The original target also tests the clone's logical identity.
+          throw TailCallException(self.callTarget, arrayOf(0L, self.papArgs.single(), n - 1))
+        }
+      }), source = Source.newBuilder("cadenza", "0", "profile-self.za").build())
+    val function = Closure(null, emptyArray(), 2, natFF, root.callTarget)
+
+    fun checkSelf(expected: Closure, call: () -> Any?) {
+      seen.clear()
+      assertEquals(0, call())
+      assertEquals(101, seen.size)
+      seen.forEachIndexed { index, actual ->
+        assertSame(expected, actual, "self identity changed on iteration $index")
+      }
+    }
+  }
+
+  private class Driver(language: Language, target: RootCallTarget) :
+    CadenzaRootNode(language, FrameLayout().build()) {
+    @Child var direct: DirectCallNode = DirectCallNode.create(target)
+    override fun execute(frame: VirtualFrame): Any? = CallUtils.callDirect(direct, frame.arguments)
+
+    fun split(): ClosureRootNode {
+      callTarget
+      assertTrue(direct.cloneCallTarget(), "the regression must exercise an actual runtime split")
+      assertTrue(direct.isCallTargetCloned)
+      return direct.currentRootNode as ClosureRootNode
+    }
+  }
+
+  @Suppress("UNCHECKED_CAST")
+  private fun profiles(root: ClosureRootNode): Array<ValueProfile> =
+    ClosureRootNode::class.java.getDeclaredField("fixedArgumentProfiles").let { field ->
+      field.isAccessible = true
+      field.get(root) as Array<ValueProfile>
+    }
+
+  @Test fun equalButDistinctFixedClosuresKeepTheirExactSelfReferences() = withLanguage { language ->
+    val body = ObservedBody(language)
+    val fix = builtin(language)
+    val first = fix.mkFix(body.function)
+    val equal = fix.mkFix(body.function)
+    assertNotSame(first, equal)
+    assertEquals(first, equal)
+    for (self in listOf(first, first, equal, first, equal)) {
+      body.checkSelf(self) { InteropLibrary.getUncached().execute(self, 100) }
+    }
+
+    val otherOwner = builtin(language).mkFix(body.function)
+    assertNotEquals(first, otherOwner)
+    body.checkSelf(otherOwner) { InteropLibrary.getUncached().execute(otherOwner, 100) }
+    body.checkSelf(first) { InteropLibrary.getUncached().execute(first, 100) }
+    assertTrue(NodeUtil.verify(body.root))
+  }
+
+  @Test fun runtimeSplitsOwnTheirProfilesAndPreserveSelfTailIdentity() = withLanguage { language ->
+    val body = ObservedBody(language)
+    val fix = builtin(language)
+    val first = fix.mkFix(body.function)
+    val equal = fix.mkFix(body.function)
+    body.checkSelf(first) { InteropLibrary.getUncached().execute(first, 100) }
+    val driver = Driver(language, body.root.callTarget)
+    val split = driver.split()
+    assertTrue(split.isSelfCall(body.root.callTarget))
+    val originalProfiles = profiles(body.root)
+    val splitProfiles = profiles(split)
+    assertNotSame(originalProfiles, splitProfiles)
+    originalProfiles.indices.forEach { index ->
+      assertNotSame(originalProfiles[index], splitProfiles[index], "split profile $index is shared")
+    }
+    for (self in listOf(equal, equal, first, equal)) {
+      body.checkSelf(self) { driver.callTarget.call(0L, self.papArgs.single(), 100) }
+      body.checkSelf(first) { InteropLibrary.getUncached().execute(first, 100) }
+    }
+    assertTrue(NodeUtil.verify(split))
+    assertTrue(NodeUtil.verify(body.root))
+    assertTrue(NodeUtil.verify(driver))
+  }
+
+  @Test fun oneBodyContinuesToUseEachFixedClosuresOwnCaptures() = withLanguage { language ->
+    val factory = language.parse(Source.newBuilder("cadenza",
+      "\\(offset : Nat) -> \\(self : Nat -> Nat) (n : Nat) -> " +
+        "if le n 0 then offset else self (minus n 1)", "profile-captures.za").build()).call() as Closure
+    val interop = InteropLibrary.getUncached()
+    val fix = builtin(language)
+    val functions = listOf(17, 93, 4).map { offset ->
+      val function = interop.execute(factory, offset) as Closure
+      offset to fix.mkFix(function)
+    }
+    functions.forEach { (_, fixed) -> assertSame(functions.first().second.callTarget, fixed.callTarget) }
+    repeat(3) {
+      for ((expected, fixed) in functions + functions.reversed()) {
+        assertEquals(expected, interop.execute(fixed, 10000))
+      }
+    }
+  }
+}
