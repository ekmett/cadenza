+import com.oracle.truffle.api.nodes.NodeUtil
+import com.oracle.truffle.api.nodes.RootNode
+import com.oracle.truffle.api.source.Source
+import org.graalvm.polyglot.Context
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import java.math.BigInteger
+import java.util.Collections
+import java.util.IdentityHashMap
+import java.util.concurrent.CyclicBarrier
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+class BoundSelfRootTests {
+  private fun withLanguage(action: (Language) -> Unit) {
+    Context.create("cadenza").use { context ->
+      context.initialize("cadenza")
+      context.enter()
+      try { action(Language.currentLanguage()) } finally { context.leave() }
+    }
+  }
+
+  private fun source(text: String) = Source.newBuilder("cadenza", text, "bound-self-root.za").build()
+  private fun parse(language: Language, text: String) = language.parse(source(text)).call() as Closure
+  private fun owner(language: Language) = FixNatFNodeGen.create().also {
+    BuiltinRootNode(language, it).callTarget
+  }
+
+  /** Observations are shared by deep-cloned code, but its dispatch children are not. */
+  private class Body(language: Language) {
+    private val layout = FrameLayout()
+    private val selfSlot = layout.slot("self")
+    private val argumentSlot = layout.slot("n")
+    val seen = mutableListOf<Closure>()
+    val frames: MutableSet<MaterializedFrame> = Collections.newSetFromMap(IdentityHashMap())
+    val roots: MutableSet<RootNode> = Collections.newSetFromMap(IdentityHashMap())
+    var schedule: List<Closure> = emptyList()
+    var iterations = 0
+    val code = object : Code(null) {
+      @Child private var dispatch: Dispatch = DispatchNodeGen.create(1, true)
+      override fun execute(frame: VirtualFrame): Any? {
+        val self = FrameAccess.read(frame, selfSlot) as Closure
+        seen += self
+        frames += frame.materialize()
+        roots += rootNode
+        val n = FrameAccess.read(frame, argumentSlot) as Int
+        if (n == 0) return 42
+        val next = if (schedule.isEmpty()) self else schedule[(iterations - n + 1) % schedule.size]
+        return dispatch.executeDispatch(frame, next, arrayOf(n - 1))
+      }
+    }
+    val root = ClosureRootNode(language, layout.build(), 2,
+      argPreamble = arrayOf(selfSlot to 0, argumentSlot to 1), body = ClosureBody(code),
+      source = Source.newBuilder("cadenza", "0", "observed-bound-self.za").build())
+    val function = Closure(null, emptyArray(), 2, natFF, root.callTarget)
+
+    fun reset(count: Int, sequence: List<Closure> = emptyList()) {
+      iterations = count
+      schedule = sequence
+      seen.clear()
+      frames.clear()
+      roots.clear()
+    }
+  }
+
+  private class Driver(language: Language, target: RootCallTarget) :
+    CadenzaRootNode(language, FrameLayout().build()) {
+    @Child private var direct = DirectCallNode.create(target)
+    @Child private var trampoline = TailCallLoop()
+    var escaped = 0
+    override fun execute(frame: VirtualFrame): Any? = try {
+      CallUtils.callDirect(direct, frame.arguments)
+    } catch (tail: TailCallException) {
+      escaped++
+      trampoline.execute(tail)
+    }
+    fun split(): ClosureRootNode {
+      callTarget
+      assertTrue(direct.cloneCallTarget(), "requires an actual Truffle call-target split")
+      assertTrue(direct.isCallTargetCloned)
+      return direct.currentRootNode as ClosureRootNode
+    }
+  }
+
+  @Test fun cachedBindingPreservesRepresentationAndTheOriginalBinaryBody() = withLanguage { language ->
+    val body = Body(language)
+    val site = owner(language)
+    val fixed = site.mkCachedFix(body.function)
+    val equal = site.mkCachedFix(body.function)
+    val generic = site.mkFix(body.function)
+    val bound = boundFixedTarget(fixed)!!
+    val equalBound = boundFixedTarget(equal)!!
+    val root = bound.rootNode as ClosureRootNode
+    assertSame(body.function.callTarget, fixed.callTarget)
+    assertEquals(1, fixed.arity)
+    assertEquals(natF, fixed.type)
+    assertEquals(1, fixed.papArgs.size)
+    assertNull(fixed.env)
+    assertNotSame(fixed, equal)
+    for (other in listOf(equal, generic, fixed.pap(emptyArray()))) {
+      assertEquals(fixed, other)
+      assertEquals(other, fixed)
+      assertEquals(fixed.hashCode(), other.hashCode())
+    }
+    assertNotEquals(fixed, owner(language).mkCachedFix(body.function))
+    assertNotSame(bound, equalBound)
+    assertEquals(1, root.arity)
+    assertEquals(2, body.root.arity)
+    assertNotSame(body.root.frameDescriptor, root.frameDescriptor)
+    assertFalse(root.isSelfCall(body.root.callTarget))
+    assertFalse(body.root.isSelfCall(bound))
+    assertFalse(root.isSelfCall(equalBound), "equal closures still bind distinct self references")
+    assertSame(body.root, body.code.rootNode, "binding must not adopt the original body")
+    val clonedCodes = NodeUtil.findAllNodeInstances(root, Code::class.java)
+    assertFalse(clonedCodes.any { it === body.code })
+    assertTrue(clonedCodes.isNotEmpty())
+    clonedCodes.forEach { assertSame(root, it.rootNode) }
+
+    body.reset(3)
+    val explicit = parse(language, "\\(n : Nat) -> plus n 1000")
+    assertEquals(1002, InteropLibrary.getUncached().execute(body.function, explicit, 3))
+    assertSame(explicit, body.seen.single(), "the original binary ABI must honor its explicit self")
+    body.reset(32)
+    assertEquals(42, bound.call(0L, 32))
+    assertEquals(33, body.seen.size)
+    body.seen.forEach { assertSame(fixed, it) }
+    assertTrue(NodeUtil.verify(root))
+    assertTrue(NodeUtil.verify(body.root))
+  }
+
+  @Test fun tailTransitionsPreserveExactSelfAcrossEqualBindingsAndGenericFallback() = withLanguage { language ->
+    val body = Body(language)
+    val site = owner(language)
+    val first = site.mkCachedFix(body.function)
+    val equal = site.mkCachedFix(body.function)
+    val generic = site.mkFix(body.function)
+    val differentOwner = owner(language).mkCachedFix(body.function)
+    assertEquals(first, equal)
+    assertNotSame(first, equal)
+    val driver = Driver(language, boundFixedTarget(first)!!)
+    val sequence = listOf(first, equal, generic, differentOwner)
+    body.reset(128, sequence)
+    // Every target's bloom bit is present, forcing cross-binding transitions through
+    // TailCallException instead of relying on incidental direct-call nesting.
+    assertEquals(42, driver.callTarget.call(-1L, 128))
+    assertEquals(129, body.seen.size)
+    body.seen.forEachIndexed { index, actual ->
+      assertSame(sequence[index % sequence.size], actual, "wrong bound self at iteration $index")
+    }
+    assertTrue(driver.escaped > 0, "different bindings must not reuse one unary root's self constant")
+    // Saturating a dispatch may use the original binary ABI. Replaying a retained
+    // binding must remain correct whether or not that call site is still specialized.
+    body.reset(16)
+    assertEquals(42, InteropLibrary.getUncached().execute(equal, 16))
+    body.seen.forEach { assertSame(equal, it) }
+    assertTrue(NodeUtil.verify(body.root))
+    assertTrue(NodeUtil.verify(driver))
+  }
+
+  @Test fun actualBoundRootSplitReusesItsFrameAndOnlyItsOwnLogicalIdentity() = withLanguage { language ->
+    val body = Body(language)
+    val site = owner(language)
+    val fixed = site.mkCachedFix(body.function)
+    val target = boundFixedTarget(fixed)!!
+    val driver = Driver(language, target)
+    val clone = driver.split()
+    assertNotSame(target.rootNode, clone)
+    assertTrue(clone.isSelfCall(target))
+    assertFalse(clone.isSelfCall(body.root.callTarget))
+    assertFalse(clone.isSelfCall(boundFixedTarget(site.mkCachedFix(body.function))!!))
+    body.reset(128)
+    assertEquals(42, driver.callTarget.call(-1L, 128))
+    assertEquals(129, body.seen.size)
+    body.seen.forEach { assertSame(fixed, it) }
+    assertEquals(1, body.frames.size, "self tail iterations should rebuild one cloned frame")
+    assertEquals(setOf(clone), body.roots)
+    assertEquals(0, driver.escaped)
+    assertTrue(NodeUtil.verify(clone))
+    assertTrue(NodeUtil.verify(target.rootNode))
+    assertTrue(NodeUtil.verify(body.root))
+  }
+
+  @Test fun capturedAndPrefixedBodiesKeepTheBinaryFallback() = withLanguage { language ->
+    val site = owner(language)
+    val captured = parse(language, "let answer : Nat = 42 in \\(self : Nat -> Nat) (n : Nat) -> " +
+      "if le n 0 then answer else self (minus n 1)")
+    val prefixed = parse(language, "(\\(answer : Nat) (self : Nat -> Nat) (n : Nat) -> " +
+      "if le n 0 then answer else self (minus n 1)) 42")
+    assertNotNull(captured.env)
+    assertEquals(1, prefixed.papArgs.size)
+    assertEquals(3, (prefixed.callTarget.rootNode as ClosureRootNode).arity)
+    for (function in listOf(captured, prefixed)) {
+      val fixed = site.mkCachedFix(function)
+      assertNull(boundFixedTarget(fixed))
+      assertSame(function.callTarget, fixed.callTarget)
+      assertSame(function.env, fixed.env)
+      assertEquals(site.mkFix(function), fixed)
+      assertEquals(42, InteropLibrary.getUncached().execute(fixed, 1000))
+    }
+  }
+
+  @Test fun saturatedFixSiteKeepsRetainedBindingsEqualToItsGenericResults() = withLanguage { language ->
+    val site = owner(language)
+    val target = site.rootNode.callTarget
+    val bodies = List(4) { Body(language) }
+    val retained = bodies.mapIndexed { index, body ->
+      assertEquals(42, target.call(0L, body.function, 0))
+      val fixed = body.seen.single()
+      if (index < 3) assertNotNull(boundFixedTarget(fixed)) else assertNull(boundFixedTarget(fixed))
+      fixed
+    }
+    bodies.forEachIndexed { index, body ->
+      body.reset(0)
+      assertEquals(42, target.call(0L, body.function, 0))
+      val generic = body.seen.single()
+      assertNull(boundFixedTarget(generic))
+      assertNotSame(retained[index], generic)
+      assertEquals(retained[index], generic)
+      assertEquals(generic, retained[index])
+      assertEquals(retained[index].hashCode(), generic.hashCode())
+      body.reset(8)
+      assertEquals(42, InteropLibrary.getUncached().execute(retained[index], 8))
+      body.seen.forEach { assertSame(retained[index], it) }
+    }
+  }
+
+  @Test fun installedUnaryRootHandlesPromotedArgumentsAndConcreteRecovery() {
+    CompilationTestSupport.requireOptimizingRuntime()
+    CompilationTestSupport.context().use { context ->
+      context.initialize("cadenza")
+      context.enter()
+      try {
+        val language = Language.currentLanguage()
+        val function = parse(language, "\\(self : Nat -> Nat) (n : Nat) -> " +
+          "if le n 0 then 0 else plus n (self (minus n 1))")
+        val fixed = owner(language).mkCachedFix(function)
+        val target = boundFixedTarget(fixed)!!
+        fun check(n: Int, argument: Any = n) {
+          val result = target.call(0L, argument)
+          val integer = if (result is BigInt) result.value else BigInteger.valueOf((result as Int).toLong())
+          assertEquals(BigInteger.valueOf(n.toLong() * (n + 1) / 2), integer)
+        }
+        repeat(24) { check(3 + it % 12) }
+        CompilationTestSupport.compileAndVerify(target)
+        check(100)
+        check(12, BigInt(BigInteger.valueOf(12)))
+        repeat(24) { check(3 + it % 12) }
+        CompilationTestSupport.compileAndVerify(target)
+        check(101)
+      } finally { context.leave() }
+    }
+  }
+
+  @Test fun simultaneousNoncapturingFixedCallsKeepUnaryArgumentsIndependent() {
+    val context = Context.newBuilder("cadenza").allowExperimentalOptions(true)
+      .option("cadenza.Backend", "ast").build()
+    val workers = Executors.newFixedThreadPool(4) { action ->
+      Thread(action, "bound-self-concurrent-test").apply { isDaemon = true }
+    }
+    var completed = false
+    try {
+      val function = context.eval("cadenza", "\\(self : Nat -> Nat) (n : Nat) -> " +
+        "if le n 0 then 0 else plus (mult n 7) (self (minus n 1))")
+      val fix = context.eval("cadenza", "fixNatF")
+      val partial = fix.execute(function)
+      val barrier = CyclicBarrier(4)
+      val results = (0 until 4).map { worker -> workers.submit {
+        context.enter()
+        try {
+          barrier.await(10, TimeUnit.SECONDS)
+          repeat(12) { round ->
+            val n = 5 + worker * 17 + round
+            barrier.await(10, TimeUnit.SECONDS)
+            assertEquals(7 * n * (n + 1) / 2, partial.execute(n).asInt())
+            assertEquals(7 * (n + 1) * (n + 2) / 2, fix.execute(function, n + 1).asInt())
+          }
+        } finally { context.leave() }
+      } }
+      results.forEach { it.get(30, TimeUnit.SECONDS) }
+      completed = true
+    } finally {
+      workers.shutdownNow()
+      if (completed) context.close()
+      else Thread({ context.close(true) }, "bound-self-concurrent-cleanup").apply {
+        isDaemon = true
+        start()
+      }
+    }
+  }
+}
